    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "selenium-webdriver": "^4.46.0",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "qs": "^6.13.0",
