{
  "name": "task-manager-backend",
  "version": "1.0.0",
  "description": "API pour gestionnaire de tâches",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest tests/unit.test.js tests/integration.test.js --coverage --runInBand",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix"
